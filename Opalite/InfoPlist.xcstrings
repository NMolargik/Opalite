    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opalite uses your camera to take photos you can sample colors from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opalite usa la cámara para tomar fotos de las que puedes extraer colores."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Opalite utilise votre appareil photo pour prendre des photos dont vous pouvez extraire des couleurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaliteはカメラで撮影した写真から色を抽出するために使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opalite uses your photo library so you can sample colors from your images."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opalite usa tu fototeca para que puedas extraer colores de tus imágenes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Opalite utilise votre photothèque pour vous permettre d’extraire des couleurs de vos images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaliteは写真ライブラリの画像から色を抽出するために使用します。"
          }
        }
      }
    },
    "NSSiriUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri can open colors and palettes and save new colors by voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri puede abrir colores y paletas y guardar colores nuevos por voz."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri peut ouvrir des couleurs et des palettes et enregistrer de nouvelles couleurs par la voix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriは音声で色やパレットを開いたり、新しい色を保存したりできます。"
          }
        }
      }
    },
