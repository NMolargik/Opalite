    "Report anything inappropriate. Content with %lld reports is hidden automatically, and publishing is limited to %lld items an hour." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denuncia cualquier contenido inapropiado. El contenido con %lld denuncias se oculta automáticamente, y la publicación está limitada a %lld elementos por hora."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signalez tout contenu inapproprié. Le contenu ayant reçu %lld signalements est masqué automatiquement, et la publication est limitée à %lld éléments par heure."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不適切なものは報告してください。%lld件の報告があったコンテンツは自動的に非表示になり、公開は1時間あたり%lld件までに制限されます。"
          }
        }
      },
      "shouldGenerateSymbol" : false
    },
